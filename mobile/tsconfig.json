{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // TS 6 no longer auto-includes @types/jest globals for test files.
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    // Edge Functions are Deno, not React Native: they import from URLs and use
    // the Deno global. They are typechecked by `deno check`, not by this config.
    "supabase/functions"
  ]
}
