name: Codex Risk Review

on:
  pull_request:
    types: [opened, synchronize, reopened]

jobs:
  codex-risk-review:
    runs-on: ubuntu-latest

    permissions:
      contents: read
      issues: write
      pull-requests: write

    steps:
